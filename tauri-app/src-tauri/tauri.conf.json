{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "note·taker",
  "version": "0.2.0-beta.5",
  "identifier": "com.notetaker.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "note·taker",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false,
        "center": true,
        "transparent": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Zeen1th/ai-note-taker/releases/download/v0.2.0-beta.5/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk4QzExRjkwRjc4OEFDRDkKUldUWnJJajNrQi9CbUNPclYyNHYvZEdjdGpHZDErcnAzK3VsNHZ6enZhS2EvbUdyME0zbmxNU1oK"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "resources": ["python/sidecar.py", "python/requirements.txt"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
